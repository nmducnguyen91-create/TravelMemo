# Firebase web config for optional multi-device sync (ADR-003).
# Copy to .env.local and fill in from Firebase Console > Project settings > Your apps > Web app > Config.
# Leave empty to build without sync. These identify the project; security comes from firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
